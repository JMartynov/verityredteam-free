FROM python:3.12-slim-bookworm

RUN pip install --no-cache-dir "mcp<2"

COPY fixtures/vuln_sse_mcp.py /opt/target/vuln_sse_mcp.py
COPY fixtures/fastmcp_streamable_lab.py /opt/target/fastmcp_streamable_lab.py

EXPOSE 8000 8001 8002

HEALTHCHECK --interval=2s --timeout=3s --retries=15 \
  CMD python3 -c "import urllib.request; [urllib.request.urlopen(f'http://127.0.0.1:{p}/health', timeout=2) for p in (8000, 8001, 8002)]"

CMD ["bash", "-c", "python3 /opt/target/vuln_sse_mcp.py & python3 /opt/target/fastmcp_streamable_lab.py & wait -n"]
