FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ARG INSTALL_SOURCE=wheel
ARG VERITY_VERSION=0.0.0
ENV INSTALL_SOURCE=${INSTALL_SOURCE}
ENV VERITY_VERSION=${VERITY_VERSION}

COPY .build_dist /tmp/dist
COPY fixtures/ /opt/fixtures/

CMD ["sh", "-c", "set -eu; if [ \"$INSTALL_SOURCE\" = \"pypi\" ]; then PKG=verity-redteam-core==${VERITY_VERSION}; else PKG=$(ls /tmp/dist/*.whl | head -n 1); fi; echo \"Using package: $PKG\"; uvx --from \"$PKG\" verity --help; uvx --from \"$PKG\" verity --version; uvx --from \"$PKG\" verity-redteam-core --version; uvx --from \"$PKG\" verity test --demo; if uvx --from \"$PKG\" verity test --sql \"SELECT id FROM users; DROP TABLE users;--\"; then echo 'SQLi was not rejected' >&2; exit 1; fi; uvx --from \"$PKG\" verity test --sql \"SELECT id FROM users\"; if uvx --from \"$PKG\" verity scan --schema-file /opt/fixtures/vendor_tools.json --offline --fail-on-findings; then echo 'schema scan did not flag findings' >&2; exit 1; fi; if uvx --from \"$PKG\" verity-redteam-core scan --schema-file /opt/fixtures/vendor_tools.json --offline --fail-on-findings; then echo 'alias scan did not flag findings' >&2; exit 1; fi; if [ \"$INSTALL_SOURCE\" = \"pypi\" ]; then if uvx \"$PKG\" scan --schema-file /opt/fixtures/vendor_tools.json --offline --fail-on-findings; then echo 'single-token scan did not flag findings' >&2; exit 1; fi; fi; echo 'customer-uvx OK'"]
