      {
        "name": "verity_security_scan",
        "description": "Comprehensive MCP security reconnaissance, client environment inspection, O(1) passport fingerprinting, and OSV vulnerability evaluation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "discover_endpoints",
                "scan_client_configs",
                "fingerprint_server",
                "lookup_vulnerabilities",
                "full_audit",
                "scan_ast_code",
                "call_target_tool",
                "detect_rug_pull",
                "snapshot_baseline"
              ],
              "description": "Reconnaissance action to perform."
            },
            "options": {
              "type": "object",
              "description": "Action-specific configuration and payload options.",
              "properties": {
                "transport": {
                  "type": "string",
                  "enum": [
                    "stdio",
                    "sse",
                    "http"
                  ],
                  "default": "stdio"
                },
                "command": {
                  "type": "string",
                  "description": "Executable command for stdio"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "url": {
                  "type": "string",
                  "description": "Target endpoint URL for SSE/HTTP"
                },
                "timeout_seconds": {
                  "type": "number",
                  "default": 5.0
                },
                "sandbox_root": {
                  "type": "string",
                  "description": "Root directory for client configs"
                },
                "clients": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tools": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "prompts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "resources": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "name_hint": {
                  "type": "string"
                },
                "package_name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "purl": {
                  "type": "string"
                },
                "tool": {
                  "type": "string",
                  "description": "Target tool name to invoke (for call_target_tool)"
                },
                "tool_name": {
                  "type": "string",
                  "description": "Alias for target tool name (for call_target_tool)"
                },
                "arguments": {
                  "type": "object",
                  "description": "Arguments to pass to target tool (for call_target_tool)"
                },
                "path": {
                  "type": "string",
                  "description": "Target source file or directory for AST scan"
                },
                "min_severity": {
                  "type": "string",
                  "enum": [
                    "CRITICAL",
                    "HIGH",
                    "MEDIUM",
                    "LOW",
                    "INFO"
                  ],
                  "default": "INFO"
                },
                "authorized_hashes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Map of tool_name -> canonical SHA-256 hash (for detect_rug_pull)."
                },
                "baseline_path": {
                  "type": "string",
                  "description": "Path to a JSON baseline hash map."
                },
                "save_baseline": {
                  "type": "boolean",
                  "description": "When true, save current canonical hashes to baseline_path."
                }
              }
            }
          },
          "required": [
            "action"
          ]
        }
      },
      {
